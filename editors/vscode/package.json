{
  "name": "lintel-vscode",
  "displayName": "Lintel (JSX for PHP)",
  "description": "Syntax highlighting for .lintel.php (JSX-in-PHP) and problem matching for `lintel check`",
  "version": "0.1.0",
  "publisher": "lintel",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lintel",
        "aliases": [
          "Lintel (JSX in PHP)",
          "lintel"
        ],
        "extensions": [
          ".lintel.php"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lintel",
        "scopeName": "source.lintel.php",
        "path": "./grammars/lintel.tmLanguage.json",
        "embeddedLanguages": {
          "source.php": "php",
          "meta.embedded.expression.lintel": "php"
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "lintel-check",
        "label": "Lintel diagnostics (`lintel check`)",
        "owner": "lintel",
        "source": "lintel",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "comment": "error[LNT0301]: dynamic event-handler attribute `onclick` is not allowed",
            "regexp": "^(error|warning)\\[(LNT\\d{4})\\]: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "comment": "  ┌─ resources/Button.lintel.php:12:20 (the rendered source excerpt that names the file)",
            "regexp": "^\\s*┌─\\s+(.+):(\\d+):(\\d+)\\s*$",
            "file": 1,
            "line": 2,
            "column": 3,
            "loop": true
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node test/tokenize.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
