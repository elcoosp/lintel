{
  "name": "lintl-vscode",
  "displayName": "Lintl (JSX for PHP)",
  "description": "Syntax highlighting for .lintl.php (JSX-in-PHP) and problem matching for `lintl check`",
  "version": "0.1.0",
  "publisher": "lintl",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lintl",
        "aliases": [
          "Lintl (JSX in PHP)",
          "lintl"
        ],
        "extensions": [
          ".lintl.php"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lintl",
        "scopeName": "source.lintl.php",
        "path": "./grammars/lintl.tmLanguage.json",
        "embeddedLanguages": {
          "source.php": "php",
          "meta.embedded.expression.lintl": "php"
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "lintl-check",
        "label": "Lintl diagnostics (`lintl check`)",
        "owner": "lintl",
        "source": "lintl",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "comment": "error[LNL0301]: dynamic event-handler attribute `onclick` is not allowed",
            "regexp": "^(error|warning)\\[(LNL\\d{4})\\]: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "comment": "  ┌─ resources/Button.lintl.php:12:20 (the rendered source excerpt that names the file)",
            "regexp": "^\\s*┌─\\s+(.+):(\\d+):(\\d+)\\s*$",
            "file": 1,
            "line": 2,
            "column": 3,
            "loop": true
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node test/tokenize.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
