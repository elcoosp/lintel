{
    "name": "lintel/phpstan",
    "description": "The Lintel PHPStan bridge: the compiler's LNT diagnostics surface and component signatures as PHPStan type information (architecture doc \u00a717.1 Q1, \u00a77.3-Y2)",
    "type": "phpstan-extension",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Lintel\\PhpStan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lintel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
