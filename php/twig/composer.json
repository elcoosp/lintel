{
    "name": "lintl/twig",
    "description": "The Symfony Twig bridge: the lintl_render() Twig function renders a Lintl component invocation, reusing the dev loader for .lintl.php sources (architecture doc §11 Symfony interop, §17.1-Q2 Laravel & Symfony packages)",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lintl\\Twig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lintl\\Twig\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "lintl/lintl": "*",
        "lintl/runtime": "*",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "twig/twig": "^3.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../lintl"
        },
        {
            "type": "path",
            "url": "../runtime"
        }
    ],
    "minimum-stability": "dev",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "stan": "phpstan analyse --memory-limit=1G --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "lintl/lintl": true
        }
    },
    "prefer-stable": true
}
