<?php

declare(strict_types=1);

namespace Lintl;

// The PHPStan-visible runtime surface (architecture doc §6.8): a stub the
// bridge registers alongside the generated component signatures, so the
// compiled artifacts' `\Lintl\c()`/`\Lintl\…` calls and `Html` values
// resolve even where the runtime package is not on the consumer's own
// autoloader map (its `files` autoload is invisible to PHPStan's PSR-4
// locator, which the stub validator reads). Bodies stay empty — stubs are
// trusted declarations, not code. Kept in drift-check against the real
// runtime by `tests/RuntimeStubTest.php`: a runtime helper added without
// shipping it here fails the test.

final class Html implements \Stringable
{
    public function __construct(public readonly string $s)
    {
    }

    public function __toString(): string
    {
    }

    public static function unsafeRaw(string $html): self
    {
    }
}

